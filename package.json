{
  "name": "pdfzero",
  "version": "1.0.0",
  "private": true,
  "description": "Free, open-source, browser-based PDF editor.",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .js,.jsx",
    "build:exe": "vite build && electron-builder"
  },
  "build": {
    "appId": "com.aicrag.pdfzero",
    "productName": "PDFZero",
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "target": "nsis"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
