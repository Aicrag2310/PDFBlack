{
  "name": "aicrag-pdf",
  "version": "1.0.6",
  "private": true,
  "description": "Aicrag PDF — Editor de PDF gratuito y de código abierto.",
  "author": "Aicrag",
  "type": "module",
  "main": "dist-electron/main.js",

  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .js,.jsx",
    "electron:build": "vite build && electron-builder"
  },

  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@pdfsmaller/pdf-encrypt": "^1.0.2",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "docx": "^9.7.1",
    "electron-updater": "^6.6.2",
    "jszip": "^3.10.2",
    "lucide-react": "^0.439.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.5.136",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.2.3",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.26.1",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5",
    "zustand": "^4.5.5"
  },

  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "eslint": "^9.9.1",
    "vite": "^5.4.2",
    "vite-plugin-electron": "^0.29.0"
  },

  "build": {
    "appId": "com.aicrag.pdf",
    "productName": "Aicrag PDF",
    "artifactName": "Aicrag-PDF-Setup-${version}.${ext}",
    "asar": true,

    "directories": {
      "output": "dist-electron"
    },

    "files": [
      "dist/**/*",
      "dist-electron/main.js",
      "package.json"
    ],

    "publish": {
    "provider": "github",
    "owner": "Aicrag2310",
    "repo": "PDFBlack"
  },

    "win": {
      "icon": "public/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "fileAssociations": [
      {
        "name": "Documento PDF",
        "description": "Archivos PDF compatibles con PDFBlack",
        "ext": "pdf",
        "role": "Editor"
      }
    ],

    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "build/installerIcon.ico",
      "uninstallerIcon": "build/uninstallerIcon.ico",
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp"
    }
  }
}